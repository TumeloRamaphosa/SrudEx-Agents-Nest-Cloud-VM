# ── War Room API ──────────────────────────────────────────────────────────
# API key required for mutating endpoints (content approval, posting, generation).
# If unset, all requests are allowed (dev mode only — NEVER deploy without this).
WAR_ROOM_API_KEY=
WAR_ROOM_URL=http://localhost:5000
APPROVAL_HOOK=http://localhost:3002/webhook

# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── OpenMausBot / OpenRouter / Ollama (Mac command room) ──────────────────
# Real values stay in ~/.openmausbot/config.json and the shell. Never commit them.
OPENROUTER_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_URL=https://openrouter.ai/api/v1
OLLAMA_HOST=http://127.0.0.1:11434
XAI_API_KEY=
GATEWAY_TOKEN=

# ── Higgsfield ────────────────────────────────────────────────────────────
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=

# ── AgentMail ─────────────────────────────────────────────────────────────
AGENTMAIL_TOKEN=

# ── Discord ───────────────────────────────────────────────────────────────
# ADAM SMASHER Discord Bot — github.com/TumeloRamaphosa/SrudEx-Agents-Nest-Cloud-VM
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_LOG_CHANNEL_ID=
ALLOWED_USER_IDS=
