# StudEx Agent OS environment variables
# Copy this file to .env and fill in the keys you want to use.
# DO NOT commit the real .env file.

# ── Remote AI providers ──
# Grok / xAI API (OpenAI-compatible): https://api.x.ai/v1
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1

# Quinn / Qwen / custom OpenAI-compatible endpoint
# If you mean Qwen, use: https://dashscope.aliyun.com/compatible-mode/v1
# If you have a self-hosted endpoint, set it here.
QUINN_API_KEY=
QUINN_BASE_URL=

# ── Local llama-server (phone or VM) ──
# Default is the local-hermes-portable server on the same machine.
# On a phone accessed via Tailscale, change this to e.g. http://100.x.x.x:9090/v1
LOCAL_LLAMA_API_KEY=
LOCAL_LLAMA_BASE_URL=http://localhost:9090/v1

# ── Optional: Tailscale / VM / Docker secrets ──
# TAILSCALE_AUTH_KEY=tskey-auth-...
